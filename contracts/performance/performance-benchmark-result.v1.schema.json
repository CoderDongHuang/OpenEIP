{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openeip.dev/contracts/performance/performance-benchmark-result.v1.schema.json",
  "title": "OpenEIP Performance Benchmark Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sampleCount",
    "elapsedSeconds",
    "throughputRequestsPerSecond",
    "latencyMs",
    "outcomes",
    "statusCodes",
    "errorCount",
    "result",
    "generatedAt",
    "environment",
    "target",
    "requests",
    "concurrency",
    "timeoutSeconds",
    "maxResponseBytes",
    "warmups"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "sampleCount": { "type": "integer", "minimum": 1 },
    "elapsedSeconds": { "type": "number", "minimum": 0 },
    "throughputRequestsPerSecond": { "type": "number", "minimum": 0 },
    "latencyMs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p95", "p99", "min", "max"],
      "properties": {
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "p99": { "type": "number", "minimum": 0 },
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    },
    "outcomes": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z_]+$" },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "statusCodes": {
      "type": "object",
      "propertyNames": { "pattern": "^[1-5][0-9]{2}$" },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "errorCount": { "type": "integer", "minimum": 0 },
    "result": { "enum": ["PASS", "FAIL"] },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxP99Ms"],
      "properties": { "maxP99Ms": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform"],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "host"],
      "properties": {
        "scheme": { "enum": ["http", "https"] },
        "host": { "type": "string", "minLength": 1, "maxLength": 253 }
      }
    },
    "requests": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 256 },
    "timeoutSeconds": { "type": "number", "minimum": 0.001, "maximum": 300 },
    "maxResponseBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "warmups": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "commit": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
